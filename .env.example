# Local development: copy to .env. (Server deployment uses deploy/.env.example; see SETUP.md.)
# Generate with: .venv/bin/vibe master-key
MASTER_KEY=
PCID_CLIENT_SECRET=
PCX_API_KEY=
STORE_ID=
DATA_DIR=./data
HOST=127.0.0.1
PORT=8765
# Skips Cloudflare Access; only honoured when HOST is loopback.
DEV_USER=you@example.com
ALLOWED_USERS=you@example.com=Alex
JOBS_ENABLED=false
