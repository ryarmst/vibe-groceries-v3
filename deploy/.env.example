# Copy to .env and fill in (see SETUP.md). Never commit .env. One value per line, no quotes or comments after values.

# The address people will use, e.g. https://groceries.example.com
PUBLIC_URL=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel: the long token from the install command.
TUNNEL_TOKEN=

# Encrypts stored keys and the No Frills session. Generate: openssl rand -base64 32
# Keep a copy somewhere safe: without it, you'd re-enter API keys and sign in to No Frills again.
MASTER_KEY=

# Cloudflare Access: the team domain and the application's Audience (AUD) tag.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Who may use the app, as email=Name pairs separated by commas. Use the same emails as the Access policy.
ALLOWED_USERS=

# PC Express values (see SETUP.md, step 1).
PCID_CLIENT_SECRET=
PCX_API_KEY=

# Your No Frills store number (SETUP.md, step 1).
STORE_ID=
# Where you live, for the assistant (units, seasons, which stores are around).
HOUSEHOLD_REGION=Ontario, Canada
TZ=America/Toronto

# Monthly cap for paid LLMs (Gemini's free tier counts as $0). Adjustable later in Settings.
MONTHLY_BUDGET_USD=10
DEAL_SCAN_HOURS=24
